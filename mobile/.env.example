# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo's
# equivalent of Next's NEXT_PUBLIC_*) - see src/lib/auth/api-client.ts and
# src/lib/socket/socket-provider.tsx. On a physical device "localhost" means
# the device itself, not your dev machine - point these at your machine's LAN
# IP (e.g. http://192.168.1.20:3001) when testing on hardware.
EXPO_PUBLIC_BACKEND_HTTP_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_BACKEND_WS_URL=http://localhost:3001
