# Postgres levantado por docker-compose (host 5433 -> container 5432, ver ../docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fleet_telemetry"

# Secreto HMAC para firmar/verificar access y refresh tokens a mano (shared/jwt.ts).
# Generar uno propio para cualquier entorno que no sea localhost:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-secret-change-me"

PORT=3001

# Origen permitido por CORS (debe matchear la URL del front web). Opcional,
# default http://localhost:3000 si se omite.
WEB_ORIGIN="http://localhost:3000"
